# Gemini (server-side only). Without this the app uses a simple offline question maker.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# Used automatically when the main model is busy (503), out of quota (429) or too slow.
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Firebase web config (Project settings → Your apps → Web app).
# Leave empty to run in local demo mode (data stored in the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Not used any more (no Firebase Storage); may stay empty.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
