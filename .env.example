# Gemini (server-side only). Without a key the app uses a simple offline question maker.
GEMINI_API_KEY=
# Quiz generation (default gemini-2.5-flash).
GEMINI_MODEL=gemini-3.8-flash
# PDF pages and "Rapikan dengan AI". Empty = use GEMINI_MODEL.
GEMINI_PDF_MODEL=gemini-3.5-flash-lite
# Requests per minute allowed for GEMINI_PDF_MODEL; PDF pages are spaced to it (default 15, or 5 without GEMINI_PDF_MODEL).
# GEMINI_PDF_RPM=15
# Backup for every task, used after 3 failed tries (429/503) or when a model does not exist (404). Empty = no backup.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Firebase web config (Project settings → Your apps → Web app).
# Leave empty to run in local demo mode (data stored in the browser).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Not used any more (no Firebase Storage); may stay empty.
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
