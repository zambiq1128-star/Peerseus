rules_version = '2';
// Who can use Peerseus (same rule as src/lib/access.ts; keep them in sync):
// 1. ITB accounts: email on itb.ac.id or a subdomain (mahasiswa.itb.ac.id, ...), signed in with
//    Microsoft (ITB's Microsoft 365) or with a provider that verified the email (Google).
//    Firebase never marks Microsoft emails as verified; Microsoft sign-in is sent to ITB's tenant
//    by the app (see docs/SETUP.md, "Login akun ITB (Microsoft)").
// 2. Guests (e.g. judges): verified emails (Google sign-in) listed in the document config/access,
//    field guestEmails (array of lowercase emails). Edit that list in the Firebase Console.
// Profiles: only the owner writes users/{uid}; fields the owner hid live in users/{uid}/private/profile,
// which only the owner can read (src/lib/privacy.ts). Firestore rules allow or deny whole documents,
// so a hidden field must not be in users/{uid} at all, and the rules refuse a profile that still has one.
// Private materials (Materiku) live in privateMaterials, readable and writable only by their uploader;
// public ones stay in materials, which must not hold a private one.
// Duels (duel langsung): the challenger invites as themselves; only the opponent accepts or declines, only the
// challenger cancels, either may mark an invite older than 2 minutes expired; finished duels never change.
// Solo practice history (practiceAttempts) is readable only by its owner and can't be edited.
// Proposed questions (questionProposals): readable by the proposer and the material's uploader; only that
// uploader accepts or rejects them, and the proposer can withdraw one while it is pending.
// Discussions (discussions, discussionAnswers, discussionVotes): each on exactly one parent, a public material
// (materials/{id}, never private ones) or an opportunity (opportunities/{id}); answers and votes copy the same
// parent. Authors edit and delete their own writing; the asker or the parent's owner (material uploader,
// opportunity sharer) picks the best answer (bestAnswerId only). "Cari tim" (kind) only on opportunities.
// Anyone may add one report. Votes: one per person per target (id {targetId}_{uid}), created or deleted by
// their owner, never on their own writing, never edited.
// Opportunities (Hub Peluang): anyone allowed reads; only the sharer creates (as themselves), edits and deletes;
// anyone may add one report. Seed samples (postedBy "seed") are read-only.
// Clock check (clockSync/{uid}): only its owner, only the server's time.
// Hackathon rules otherwise: any allowed user can read and write the rest of the app data
// (duels update both players' ratings). Tighten before real users.
service cloud.firestore {
  match /databases/{database}/documents {
    function userEmail() {
      return request.auth.token.email.lower();
    }

    function emailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isItb() {
      return userEmail().matches('^[^@]+@([a-z0-9-]+[.])*itb[.]ac[.]id$')
        && (request.auth.token.firebase.sign_in_provider == 'microsoft.com' || emailVerified());
    }

    function isGuest() {
      let access = /databases/$(database)/documents/config/access;
      return emailVerified()
        && exists(access)
        && userEmail() in get(access).data.get('guestEmails', []);
    }

    function allowed() {
      return request.auth != null && (isItb() || isGuest());
    }

    // The guest list: readable by allowed users (the app checks it at sign-in), editable only in the console.
    match /config/{doc} {
      allow read: if allowed();
      allow write: if false;
    }

    // Hidden fields are absent from the public profile (missing switch = shown). Keep in sync with HIDEABLE.
    function respectsPrivacy(d) {
      let p = d.get('privacy', {});
      return (p.get('showProgram', true) == true || !d.keys().hasAny(['program', 'dreamProgram']))
        && (p.get('showEntryYear', true) == true || !d.keys().hasAny(['entryYear']))
        && (p.get('showContact', true) == true || !d.keys().hasAny(['contact']));
    }

    // The ITB/guest badge must match the sign-in token (missing = unknown, e.g. demo peers and old profiles).
    function honestItbFlag(d) {
      return !d.keys().hasAny(['isItbVerified']) || d.isItbVerified == isItb();
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if allowed();
      // Demo peers (bot_...) are written by the seed, run by whoever signs in first.
      allow write: if allowed()
        && (isOwner(uid) || (uid.matches('bot_.*') && request.resource.data.get('isBot', false) == true))
        && respectsPrivacy(request.resource.data)
        && honestItbFlag(request.resource.data);

      match /private/{doc} {
        allow read, write: if allowed() && isOwner(uid);
      }
    }

    // Public materials. Private ones (isPublic == false) belong in privateMaterials.
    match /materials/{id} {
      allow read, delete: if allowed();
      allow create, update: if allowed() && request.resource.data.get('isPublic', true) == true;
    }

    match /privateMaterials/{id} {
      function mine() {
        return allowed() && resource.data.uploaderId == request.auth.uid;
      }
      function staysMine() {
        return allowed() && request.resource.data.uploaderId == request.auth.uid
          && request.resource.data.get('isPublic', true) == false;
      }
      allow read, delete: if mine();
      allow create: if staysMine();
      allow update: if mine() && staysMine();
    }

    // Duels (duel langsung). Only live duels (mode "live") are created and changed; old turn-based ones
    // ("pending", "completed", "declined" without a mode) are history and never change again.
    // invited → ready (accepted) → playing → completed, or invited → declined | expired | cancelled.
    // Times come from the server: invitedAt, acceptedAt, declinedAt, cancelledAt, expiredAt == request.time.
    match /duels/{id} {
      function d() { return resource.data; }
      function n() { return request.resource.data; }
      function me() { return request.auth.uid; }
      function changed() { return n().diff(d()).affectedKeys(); }
      function inviteOpen() { return d().status == 'invited' && request.time <= d().invitedAt + duration.value(2, 'm'); }
      function inviteOver() { return d().status == 'invited' && request.time > d().invitedAt + duration.value(2, 'm'); }
      // opponentIsBot must match the opponent's profile, so a real person can't be "accepted" by the challenger.
      function botFlagHonest(x) {
        let u = /databases/$(database)/documents/users/$(x.opponentId);
        return x.get('opponentIsBot', false) == (exists(u) && get(u).data.get('isBot', false) == true);
      }
      function validInvite() {
        return n().get('mode', '') == 'live'
          && n().status == 'invited'
          && n().id == id
          && n().challengerId == me()
          && n().opponentId is string && n().opponentId != me()
          && n().participants == [n().challengerId, n().opponentId]
          && n().invitedAt == request.time
          && n().questions is list && n().questions.size() > 0 && n().questions.size() <= 6
          && !n().keys().hasAny(['acceptedAt', 'declinedAt', 'cancelledAt', 'expiredAt', 'challenger', 'opponent', 'winnerId', 'eloChange'])
          && botFlagHonest(n());
      }
      function accepts() {
        return inviteOpen()
          && (me() == d().opponentId || (d().get('opponentIsBot', false) == true && me() == d().challengerId))
          && n().status == 'ready' && n().acceptedAt == request.time
          && changed().hasOnly(['status', 'acceptedAt']);
      }
      function declines() {
        return inviteOpen() && me() == d().opponentId && d().get('opponentIsBot', false) != true
          && n().status == 'declined' && n().declinedAt == request.time
          && changed().hasOnly(['status', 'declinedAt']);
      }
      function cancels() {
        return d().status == 'invited' && me() == d().challengerId
          && n().status == 'cancelled' && n().cancelledAt == request.time
          && changed().hasOnly(['status', 'cancelledAt']);
      }
      function expires() {
        return inviteOver() && me() in d().participants
          && n().status == 'expired' && n().expiredAt == request.time
          && changed().hasOnly(['status', 'expiredAt']);
      }
      // Playing: each player writes only their own live side (challengerLive / opponentLive: answers so far, times,
      // lastSeen == request.time). Answers only grow, never past the number of questions, and none before the start
      // (acceptedAt + 5 s; 1 s slack for clocks). The challenger also writes a demo peer's side.
      function liveKeys() {
        return d().get('opponentIsBot', false) == true && me() == d().challengerId
          ? ['challengerLive', 'opponentLive']
          : [me() == d().challengerId ? 'challengerLive' : 'opponentLive'];
      }
      // Every time (live or final) is a number of ms from 0 to 20000 (one question's time; a value that is not
      // a number fails the comparison, which denies). Written out per index (at most 6 questions, see validInvite)
      // because rules have no loops.
      function timeOk(t, i) {
        return t.size() <= i || (t[i] >= 0 && t[i] <= 20000);
      }
      function timesOk(t) {
        return timeOk(t, 0) && timeOk(t, 1) && timeOk(t, 2) && timeOk(t, 3) && timeOk(t, 4) && timeOk(t, 5);
      }
      function liveOk(key) {
        let a0 = d().get(key, {}).get('answers', []);
        let t0 = d().get(key, {}).get('timesMs', []);
        let after = n().get(key, {});
        let a1 = after.get('answers', []);
        let t1 = after.get('timesMs', []);
        return !(key in changed())
          || (after.keys().hasOnly(['answers', 'timesMs', 'lastSeen'])
            && after.lastSeen == request.time
            && a1.size() >= a0.size() && a1.size() <= d().questions.size() && t1.size() == a1.size()
            && (a0.size() == 0 || a1[0:a0.size()] == a0) && (t0.size() == 0 || t1[0:t0.size()] == t0)
            && timesOk(t1)
            && (a1.size() == a0.size() || request.time >= d().acceptedAt + duration.value(4, 's')));
      }
      function plays() {
        return d().status in ['ready', 'playing'] && me() in d().participants
          && (n().status == d().status || n().status == 'playing')
          && changed().hasOnly(liveKeys().concat(['status']))
          && liveOk('challengerLive') && liveOk('opponentLive');
      }
      // Settling, exactly once (status "completed" never changes again): both final sides, winnerId, eloChange,
      // completedAt == request.time and endReason in one write, only when the duel is over by the server's clock:
      // the last question's time is up (start + 20 s each + 5 s), or each side answered everything or was silent 30 s.
      function over(key) {
        let l = d().get(key, {});
        return l.get('answers', []).size() == d().questions.size()
          || request.time > l.get('lastSeen', d().acceptedAt) + duration.value(30, 's');
      }
      function timeUp() {
        return request.time > d().acceptedAt + duration.value(10 + 20 * d().questions.size(), 's');
      }
      // Final sides keep the live answers (missing ones are -1) and their score and total time add up.
      // Written out per question (at most 6, see validInvite) because rules have no loops.
      function scoreOf(a, q) {
        return (q.size() > 0 && a[0] == q[0].answerIndex ? 1 : 0) + (q.size() > 1 && a[1] == q[1].answerIndex ? 1 : 0)
          + (q.size() > 2 && a[2] == q[2].answerIndex ? 1 : 0) + (q.size() > 3 && a[3] == q[3].answerIndex ? 1 : 0)
          + (q.size() > 4 && a[4] == q[4].answerIndex ? 1 : 0) + (q.size() > 5 && a[5] == q[5].answerIndex ? 1 : 0);
      }
      function sumOf(t) {
        return (t.size() > 0 ? t[0] : 0) + (t.size() > 1 ? t[1] : 0) + (t.size() > 2 ? t[2] : 0)
          + (t.size() > 3 ? t[3] : 0) + (t.size() > 4 ? t[4] : 0) + (t.size() > 5 ? t[5] : 0);
      }
      // Final sides are the live answers and times, then -1 with the full 20000 ms for each question never answered
      // (left or out of time), so no answer can be added at the end. Final times are therefore in range too: each live
      // time was checked by timesOk when it was written (checking them again here goes past the 1000-expression limit
      // for a guest with 6 questions).
      function finalOk(f, live, q) {
        let liveA = live.get('answers', []);
        let liveT = live.get('timesMs', []);
        let missed = q.size() - liveA.size();
        return liveT.size() == liveA.size()
          // (an empty slice [0:0] is an error in rules, hence the missed == 0 case)
          && f.answers == (missed == 0 ? liveA : liveA.concat([-1, -1, -1, -1, -1, -1][0:missed]))
          && f.timesMs == (missed == 0 ? liveT : liveT.concat([20000, 20000, 20000, 20000, 20000, 20000][0:missed]))
          && f.score == scoreOf(f.answers, q) && f.totalMs == sumOf(liveT) + 20000 * missed;
      }
      // Same rule as the app: higher score wins, then faster total time by more than 0.5 s, otherwise a draw (null).
      function winnerOk() {
        let c = n().challenger;
        let o = n().opponent;
        let w = n().winnerId;
        return c.score > o.score ? w == d().challengerId
          : c.score < o.score ? w == d().opponentId
          : math.abs(c.totalMs - o.totalMs) > 500 ? w == (c.totalMs < o.totalMs ? d().challengerId : d().opponentId)
          : w == null;
      }
      // Elo K = 32: the two changes cancel out and neither is more than 32; a duel against a demo peer is 0/0.
      function eloOk() {
        let e = n().eloChange;
        return e.keys().hasOnly(['challenger', 'opponent']) && e.challenger is int && e.opponent is int
          && e.challenger + e.opponent == 0 && math.abs(e.challenger) <= 32
          && (d().get('opponentIsBot', false) != true || (e.challenger == 0 && e.opponent == 0));
      }
      function settles() {
        return d().status in ['ready', 'playing'] && me() in d().participants
          && n().status == 'completed' && n().completedAt == request.time
          && n().endReason in ['done', 'timeout', 'left']
          && changed().hasOnly(['challenger', 'opponent', 'status', 'winnerId', 'eloChange', 'completedAt', 'endReason'])
          && (timeUp() || (over('challengerLive') && over('opponentLive')))
          && finalOk(n().challenger, d().get('challengerLive', {}), d().questions)
          && finalOk(n().opponent, d().get('opponentLive', {}), d().questions)
          && winnerOk() && eloOk();
      }
      allow read: if allowed();
      allow create: if allowed() && validInvite();
      allow update: if allowed() && d().get('mode', '') == 'live'
        // Checked by the current status first, so each write only evaluates the rules that can apply to it.
        && (d().status == 'invited' ? (accepts() || declines() || cancels() || expires())
          : n().status == 'completed' ? settles()
          : plays());
      allow delete: if false;
    }

    // Kuis mandiri history: one document per finished run, only its owner reads or deletes it.
    match /practiceAttempts/{id} {
      allow read, delete: if allowed() && resource.data.uid == request.auth.uid;
      allow create: if allowed() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    // Usul soal. uploaderId must be the material's uploader, so a proposal can't be routed to someone else.
    match /questionProposals/{id} {
      function proposer(d) {
        return d.proposerId == request.auth.uid;
      }
      function reviewer(d) {
        return d.uploaderId == request.auth.uid;
      }
      allow read: if allowed() && (proposer(resource.data) || reviewer(resource.data));
      allow create: if allowed() && proposer(request.resource.data)
        && request.resource.data.status == 'pending'
        && request.resource.data.uploaderId == get(/databases/$(database)/documents/materials/$(request.resource.data.materialId)).data.uploaderId;
      allow update: if allowed() && reviewer(resource.data)
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted', 'rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'question', 'rejectReason', 'reviewedAt']);
      allow delete: if allowed() && proposer(resource.data) && resource.data.status == 'pending';
    }

    // ---------- Diskusi ----------
    function docPath(col, id) {
      return /databases/$(database)/documents/$(col)/$(id);
    }
    function textOk(d, field, max) {
      return d[field] is string && d[field].size() > 0 && d[field].size() <= max;
    }
    // One more report and nothing else (same pattern as materials and quizzes).
    function addsReport() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reports'])
        && request.resource.data.reports == resource.data.get('reports', 0) + 1;
    }

    // Every discussion, answer and vote hangs on exactly one parent: materialId (a public material in materials)
    // or opportunityId (an opportunity). Old documents only have materialId and keep working as before.
    function onMaterial(d) {
      return d.keys().hasAny(['materialId']) && !d.keys().hasAny(['opportunityId']);
    }
    function onOpportunity(d) {
      return d.keys().hasAny(['opportunityId']) && !d.keys().hasAny(['materialId']);
    }
    // d (an answer or vote) names the same parent as p (its discussion, or the answer it votes on).
    function sameParent(d, p) {
      return (onMaterial(d) && onMaterial(p) && d.materialId == p.materialId)
        || (onOpportunity(d) && onOpportunity(p) && d.opportunityId == p.opportunityId);
    }

    match /discussions/{id} {
      function asker() {
        return resource.data.authorId == request.auth.uid;
      }
      // The material's uploader or the opportunity's sharer (postedBy; "seed" is nobody).
      function parentOwner() {
        let d = resource.data;
        return onMaterial(d)
          ? get(docPath('materials', d.materialId)).data.uploaderId == request.auth.uid
          : get(docPath('opportunities', d.opportunityId)).data.postedBy == request.auth.uid;
      }
      // bestAnswerId: null (taken back) or an answer of this discussion.
      function validBest() {
        let b = request.resource.data.bestAnswerId;
        return b == null || (exists(docPath('discussionAnswers', b)) && get(docPath('discussionAnswers', b)).data.discussionId == id);
      }
      // Materials: same course as the material, only "tanya" (kind missing or "tanya").
      function validMaterialParent(d) {
        return onMaterial(d)
          && exists(docPath('materials', d.materialId))
          && d.courseId == get(docPath('materials', d.materialId)).data.courseId
          && d.get('kind', 'tanya') == 'tanya';
      }
      // Opportunities: no material-only fields; kind "tanya" or "cari-tim" (missing = "tanya").
      function validOpportunityParent(d) {
        return onOpportunity(d)
          && exists(docPath('opportunities', d.opportunityId))
          && !d.keys().hasAny(['courseId', 'questionId', 'topic'])
          && d.get('kind', 'tanya') in ['tanya', 'cari-tim'];
      }
      // What the asker may edit: materials title/body/quiz context, opportunities title/body/kind. Never the parent.
      function validAskerEdit() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return textOk(request.resource.data, 'title', 150)
          && textOk(request.resource.data, 'body', 10000)
          && ((onMaterial(resource.data) && changed.hasOnly(['title', 'body', 'questionId', 'topic', 'updatedAt']))
            || (onOpportunity(resource.data) && changed.hasOnly(['title', 'body', 'kind', 'updatedAt'])
              && request.resource.data.get('kind', 'tanya') in ['tanya', 'cari-tim']));
      }
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.authorId == request.auth.uid
        && (validMaterialParent(request.resource.data) || validOpportunityParent(request.resource.data))
        && !request.resource.data.keys().hasAny(['bestAnswerId', 'updatedAt'])
        && request.resource.data.reports == 0
        && textOk(request.resource.data, 'title', 150)
        && textOk(request.resource.data, 'body', 10000);
      allow update: if allowed() && (
        (asker() && validAskerEdit())
        || ((asker() || parentOwner())
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bestAnswerId'])
          && validBest())
        || addsReport());
      allow delete: if allowed() && asker();
    }

    match /discussionAnswers/{id} {
      function author() {
        return resource.data.authorId == request.auth.uid;
      }
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.authorId == request.auth.uid
        && exists(docPath('discussions', request.resource.data.discussionId))
        && sameParent(request.resource.data, get(docPath('discussions', request.resource.data.discussionId)).data)
        && !request.resource.data.keys().hasAny(['updatedAt'])
        && request.resource.data.reports == 0
        && textOk(request.resource.data, 'body', 10000);
      allow update: if allowed() && (
        (author()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt'])
          && textOk(request.resource.data, 'body', 10000))
        || addsReport());
      allow delete: if allowed() && author();
    }

    match /discussionVotes/{id} {
      function target() {
        let d = request.resource.data;
        return get(docPath(d.targetType == 'discussion' ? 'discussions' : 'discussionAnswers', d.targetId)).data;
      }
      allow read: if allowed();
      allow create: if allowed()
        && request.resource.data.uid == request.auth.uid
        && id == request.resource.data.targetId + '_' + request.auth.uid
        && request.resource.data.targetType in ['discussion', 'answer']
        && target().authorId != request.auth.uid
        && sameParent(request.resource.data, target());
      allow update: if false;
      allow delete: if allowed() && resource.data.uid == request.auth.uid;
    }

    // ---------- Hub Peluang ----------
    // Anyone allowed reads. Only the sharer (postedBy) creates as themselves, edits and deletes; anyone may add
    // one report (+1, nothing else). Seed samples (postedBy "seed", ids opp_seed_0..4, exact title and link) can be created once by the
    // seeding user and are read-only afterwards: nobody's uid is "seed", so they can't be edited or deleted.
    match /opportunities/{id} {
      function oppFields(d) {
        return d.keys().hasOnly(['id', 'title', 'type', 'organizer', 'majors', 'deadline', 'link', 'description', 'postedBy', 'createdAt', 'updatedAt', 'reports']);
      }
      function oppValid(d) {
        return textOk(d, 'title', 150)
          && textOk(d, 'organizer', 150)
          && textOk(d, 'description', 5000)
          && d.type in ['beasiswa', 'lomba', 'seminar', 'lainnya']
          && d.deadline is string
          && d.deadline.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')
          && d.link is string && d.link.size() <= 500 && d.link.matches('^https://[^ ]+$')
          && d.majors is list && d.majors.size() <= 12
          && d.majors.hasOnly(['STEI', 'FTI', 'FMIPA', 'SITH', 'SF', 'FTSL', 'FTTM', 'FITB', 'FTMD', 'SAPPK', 'SBM', 'FSRD']);
      }
      // The five samples from src/lib/seed.ts (OPPS), by id, with their exact title and link. Keep in sync.
      function isSeedSample(oppId, d) {
        let titles = {'opp_seed_0': 'Beasiswa Prestasi Mahasiswa Tahun Pertama (contoh)', 'opp_seed_1': 'Lomba Karya Tulis Inovasi Teknologi (contoh)', 'opp_seed_2': 'Seminar Riset Sains untuk Mahasiswa Baru (contoh)', 'opp_seed_3': 'Kompetisi Desain Struktur Jembatan (contoh)', 'opp_seed_4': 'Beasiswa Riset Lingkungan (contoh)'};
        return oppId in titles && d.title == titles[oppId] && d.link == 'https://example.com';
      }
      function poster() {
        return resource.data.postedBy == request.auth.uid;
      }
      allow read: if allowed();
      allow create: if allowed()
        && oppFields(request.resource.data)
        && request.resource.data.id == id
        && request.resource.data.createdAt is number
        && request.resource.data.get('reports', 0) == 0
        && !request.resource.data.keys().hasAny(['updatedAt'])
        && oppValid(request.resource.data)
        && (request.resource.data.postedBy == request.auth.uid
          || (request.resource.data.postedBy == 'seed' && isSeedSample(id, request.resource.data)));
      allow update: if allowed() && (
        (poster()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'type', 'organizer', 'deadline', 'majors', 'link', 'description', 'updatedAt'])
          && oppValid(request.resource.data)
          && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is number))
        || addsReport());
      allow delete: if allowed() && poster();
    }

    // Server clock check (syncServerClock in src/lib/db.ts): each person writes only their own document,
    // holding only the server's time, and reads it back to measure how far their device clock is off.
    match /clockSync/{uid} {
      allow read: if allowed() && request.auth.uid == uid;
      allow create, update: if allowed() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
    }

    // All other app data.
    match /{col}/{rest=**} {
      allow read, write: if !(col in ['config', 'users', 'materials', 'privateMaterials', 'duels', 'practiceAttempts', 'questionProposals', 'opportunities', 'discussions', 'discussionAnswers', 'discussionVotes', 'clockSync']) && allowed();
    }
  }
}
